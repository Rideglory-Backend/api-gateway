PORT=3000

# PostgreSQL for Notifications table (api-gateway Prisma — first-time setup)
# Start local DB: docker compose up -d (see api-gateway/docker-compose.yml — port 5434)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gateway?schema=public"

VEHICLES_MS_PORT=3001
VEHICLES_MS_HOST=localhost

EVENTS_MS_PORT=3002
EVENTS_MS_HOST=localhost

USERS_MS_PORT=3003
USERS_MS_HOST=localhost

MAINTENANCES_MS_PORT=3004
MAINTENANCES_MS_HOST=localhost

# Firebase auth configuration (set one of these options)
# FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Places
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Mapbox — used for geocode proxy (GET /api/places/geocode)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Anthropic (Claude) — used for AI query generation
ANTHROPIC_API_KEY=your-anthropic-api-key

# Unsplash — used for event cover image search
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
