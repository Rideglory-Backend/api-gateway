PORT=3000

VEHICLES_MS_PORT=3001
VEHICLES_MS_HOST=localhost

EVENTS_MS_PORT=3002
EVENTS_MS_HOST=localhost

USERS_MS_PORT=3003
USERS_MS_HOST=localhost

MAINTENANCES_MS_PORT=3004
MAINTENANCES_MS_HOST=localhost

# notifications-ms — handles FCM dispatch and notification center
NOTIFICATIONS_MS_PORT=3005
NOTIFICATIONS_MS_HOST=localhost

# Firebase auth configuration (set one of these options)
# FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Mapbox — fallback geocoding (used only if GOOGLE_PLACES_API_KEY is not set)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Google Places — autocomplete and geocoding (recommended, replaces Mapbox for establishment searches)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Anthropic (Claude) — used for AI query generation
ANTHROPIC_API_KEY=your-anthropic-api-key

# Unsplash — used for event cover image search
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Gemini — AI description generation
GEMINI_API_KEY=your-gemini-api-key
# Gemini text model (default: gemini-2.5-flash)
# GEMINI_TEXT_MODEL=gemini-2.5-flash
